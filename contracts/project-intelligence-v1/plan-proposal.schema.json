{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zhishu.local/contracts/project-intelligence-v1/plan-proposal.schema.json",
  "title": "Zhishu Plan Proposal V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "name", "objective", "creationReason", "baseStateRevision", "basePlanVersion", "contextPackageId", "provider", "model", "permissions", "nodes"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "name": { "type": "string", "minLength": 1 },
    "objective": { "type": "string", "minLength": 1 },
    "creationReason": { "type": "string", "minLength": 1 },
    "planId": { "type": ["string", "null"], "format": "uuid" },
    "baseStateRevision": { "type": "integer", "minimum": 0 },
    "basePlanVersion": { "type": ["integer", "null"], "minimum": 1 },
    "contextPackageId": { "type": "string", "format": "uuid" },
    "provider": { "type": "string", "minLength": 1 },
    "model": { "type": "string", "minLength": 1 },
    "permissions": { "type": "object" },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/PlanNodeProposalV1" }
    }
  },
  "$defs": {
    "PlanNodeProposalV1": {
      "type": "object",
      "additionalProperties": false,
      "required": ["nodeKey", "title", "objective", "scope", "acceptanceCriteria", "priority", "requiredCapabilities", "requiresHumanApproval", "dependsOn"],
      "properties": {
        "nodeKey": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "objective": { "type": "string", "minLength": 1 },
        "scope": { "type": "array", "items": { "type": "string" } },
        "acceptanceCriteria": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "priority": { "type": "integer" },
        "requiredCapabilities": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "requiresHumanApproval": { "type": "boolean" },
        "dependsOn": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "relationType": { "enum": ["INHERITED", "SUPERSEDED", "NEW"] },
        "previousNodeKey": { "type": ["string", "null"] }
      }
    }
  }
}
